# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo para scripts de seed (nunca se usa en el navegador)
SUPABASE_SERVICE_ROLE_KEY=
# Supabase → Connect → Session pooler (para aplicar migraciones con npm run db:setup)
SUPABASE_DB_URL=postgresql://postgres.TU-PROYECTO:CONTRASEÑA@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Anthropic (solo servidor)
ANTHROPIC_API_KEY=

# Contraseña de los 2 usuarios de prueba que crea el seed
DEMO_PASSWORD=chuicaca-2026

# Host del API, SIN /api/v1. El cliente arma ${NEXT_PUBLIC_API_URL}/api/v1.
# Local: http://localhost:8000
# Túnel: https://<host>.trycloudflare.com
# Vacío, o NEXT_PUBLIC_SIGO_MOCKS=1, usa el servidor simulado.
NEXT_PUBLIC_API_URL=
# NEXT_PUBLIC_SIGO_MOCKS=0
