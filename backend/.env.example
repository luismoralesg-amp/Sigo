# Copiá a backend/.env. Sin secretos reales.
SIGO_ENV=desarrollo
SIGO_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://sigo.vercel.app
# SIGO_CORS_ORIGIN_REGEX=https://.*\.trycloudflare\.com
SIGO_PUBLIC_API_URL=http://localhost:8000
SIGO_PUBLIC_APP_URL=https://sigo.app
SIGO_SECRET=cambia-esto
# Solo enciende POST /api/v1/dev/sesion si SIGO_ENV=desarrollo.
# En produccion, en demo, o si esta variable no está, el endpoint responde 404.
SIGO_DEV_LOGIN=true
SIGO_MODO_DEMO=false
SIGO_DPI_VERIFICADOR_ESTRICTO=false
SIGO_SMS=simulado
# Módulos: mock (backend solo) | real (modulos-arturo)
SIGO_VISION_IMPL=mock
SIGO_IMPORTAR_IMPL=mock
SIGO_CAG_IMPL=mock
SIGO_EXPORT_IMPL=mock
# Supabase (login del personal)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=
# Para modulos-arturo
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_VISION_MODEL=qwen2.5vl:7b
VISION_MODE=local
